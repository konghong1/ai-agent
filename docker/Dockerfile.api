FROM python:3.12-slim AS builder

WORKDIR /app

# Configure mirrors for improved reliability (China-friendly)
# Fall back to official mirrors if mirrors.tuna.tsinghua.edu.cn is slow
RUN sed -i 's|http://deb.debian.org/debian|https://mirrors.aliyun.com/debian|g' /etc/apt/sources.list.d/debian.sources || true \
    && apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    wget \
    && rm -rf /var/lib/apt/lists/*

# Install build dependencies (gcc + MariaDB client libs)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    libmariadb-dev-compat libmariadb-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy and install all requirements at once
COPY requirements.txt .

# Pre-install setuptools & wheel first (needed for langdetect build)
RUN pip install --no-cache-dir --prefix=/install \
    --timeout 600 --retries 10 \
    "setuptools>=68.0.0" "wheel>=0.42.0"

# Install CPU-ONLY torch FIRST (version matched to the ML stack) so that
# sentence-transformers / transformers do NOT pull the multi-GB CUDA 13 build.
# The container runs on CPU (no `--gpus` / nvidia runtime in compose), so the
# CUDA libs (nvidia-*-cu13, triton) are pure dead weight. Without this pin, pip
# resolves `torch` on Linux to the CUDA wheel and the image balloons to ~12.7GB.
RUN pip install --no-cache-dir --prefix=/install \
    --timeout 600 --retries 10 \
    "torch==2.13.0+cpu" --index-url https://download.pytorch.org/whl/cpu

# Then install project requirements (torch already satisfied → no CUDA pull)
RUN pip install --no-cache-dir --prefix=/install \
    --timeout 600 --retries 10 \
    -r requirements.txt

# ── Final image ──────────────────────────────────────────────
FROM python:3.12-slim

WORKDIR /app

# Runtime deps only
RUN sed -i 's|http://deb.debian.org/debian|https://mirrors.aliyun.com/debian|g' /etc/apt/sources.list.d/debian.sources || true \
    && apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages from builder stage
COPY --from=builder /install /usr/local

# Copy application code
COPY . .

EXPOSE 8010

CMD ["uvicorn", "app.server:app", "--host", "0.0.0.0", "--port", "8010"]
