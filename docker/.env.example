# ── Database Type Switch ───────────────────────────────────────
# Supported: mysql | postgresql
# Default: mysql
DATABASE_TYPE=mysql

# ── MySQL Configuration ────────────────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DB=ai_agent
MYSQL_USER=ai_agent
MYSQL_PASSWORD=ai_agent_secure_2026

# ── PostgreSQL Configuration ───────────────────────────────────
# Used when DATABASE_TYPE=postgresql
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_agent
POSTGRES_USER=ai_agent
POSTGRES_PASSWORD=ai_agent_secure_2026

# ── Derived ────────────────────────────────────────────────────
# Automatically computed based on DATABASE_TYPE
DATABASE_URL=${DATABASE_TYPE}://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_DB}

# ── Object Storage (MinIO) ─────────────────────────────────────
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=media-assets
MINIO_PUBLIC_URL=http://localhost:9000/media-assets
MINIO_USE_SSL=false

# ── Agnes AI API ───────────────────────────────────────────────
AGNES_API_KEY=sk-0T1BpcsI51cKxXgWZejpvONrcUs8vDc1Tqzz7NkObIWAyezd
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# ── App ────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
DEBUG=false

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Ports ──────────────────────────────────────────────────────
API_PORT=8010
WEB_PORT=80

ENABLE_CONTEXT_SERVICE=true
ENABLE_RETRIEVAL_REFLEX=true      # 指针层
# ENABLE_MEMORY_RECALL=true      # Chroma 语义回忆（需 embedding 可用）
